{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native (tests, warnings as errors)",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PHYSICS_BUILD_TESTS": "ON",
        "PHYSICS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly via Emscripten (embind module)",
      "description": "Requires the EMSDK environment variable. Outputs build/wasm/dist/engine.{js,wasm}.",
      "binaryDir": "${sourceDir}/build/wasm",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fno-exceptions",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "PHYSICS_BUILD_TESTS": "OFF",
        "PHYSICS_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "wasm", "configurePreset": "wasm", "targets": ["physics_wasm"] }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": { "outputOnFailure": true }
    }
  ]
}
